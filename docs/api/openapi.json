{
  "openapi": "3.0.3",
  "info": {
    "title": "CampusBridge Student and Instructor API Specification",
    "description": "Official REST API contract for the Student and Instructor modules of the CampusBridge university learning and internship platform. Strictly audited against CampusBridge SRS v2.0.\n",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5001/api/v1",
      "description": "Local development API server"
    }
  ],
  "paths": {
    "/profile": {
      "get": {
        "summary": "Retrieve authenticated user profile",
        "description": "Returns user profile, academic details, skills, CV metadata, and UI preferences (FR-03, FR-38).",
        "tags": [
          "Profile"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Profile retrieved successfully"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      },
      "put": {
        "summary": "Update profile and UI preferences",
        "description": "Updates name, program, year, skills, or theme preferences (FR-03, FR-23, FR-38, FR-39).",
        "tags": [
          "Profile"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 100
                  },
                  "program": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "year": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 7
                  },
                  "department": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "skills": {
                    "type": "array",
                    "maxItems": 15,
                    "items": {
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 30
                    }
                  },
                  "preferences": {
                    "type": "object",
                    "properties": {
                      "theme": {
                        "type": "string",
                        "enum": [
                          "dark",
                          "light"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated successfully"
          },
          "400": {
            "$ref": "#/components/responses/BadRequestError"
          }
        }
      }
    },
    "/profile/cv": {
      "post": {
        "summary": "Upload or replace student CV (Max 2 MB, PDF/Word)",
        "description": "Attaches one CV file (PDF or Word, up to 2 MB) to student profile (FR-23, SEC-07).",
        "tags": [
          "Profile"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "cv"
                ],
                "properties": {
                  "cv": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "CV uploaded and attached successfully"
          },
          "413": {
            "description": "File size exceeds 2 MB"
          },
          "415": {
            "description": "Unsupported file format (PDF and Word only)"
          }
        }
      }
    },
    "/courses": {
      "get": {
        "summary": "List courses",
        "description": "Returns courses catalog for students or assigned courses for instructors (FR-04, FR-05).",
        "tags": [
          "Courses"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Courses retrieved"
          }
        }
      }
    },
    "/courses/{id}": {
      "get": {
        "summary": "View course details",
        "description": "Returns syllabus and metadata for specific course (FR-05).",
        "tags": [
          "Courses"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Course details retrieved"
          },
          "404": {
            "$ref": "#/components/responses/NotFoundError"
          }
        }
      }
    },
    "/courses/{id}/enroll": {
      "post": {
        "summary": "Enroll in course",
        "description": "Enrolls student in active course (FR-05).",
        "tags": [
          "Courses"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Enrolled successfully"
          },
          "409": {
            "description": "Student already enrolled in this course"
          }
        }
      }
    },
    "/courses/{id}/resources": {
      "get": {
        "summary": "View course learning materials",
        "description": "View resources for enrolled course (requires active enrollment or assigned instructor) (FR-05).",
        "tags": [
          "Courses"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resources retrieved"
          },
          "403": {
            "description": "Forbidden - student not enrolled"
          }
        }
      },
      "post": {
        "summary": "Upload learning resource (Assigned Instructor only)",
        "description": "Adds document, slides, or resource link to course (FR-04).",
        "tags": [
          "Courses"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "url"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 150
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "pdf",
                      "document",
                      "slides",
                      "link",
                      "video",
                      "other"
                    ]
                  },
                  "url": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Resource added successfully"
          }
        }
      }
    },
    "/courses/{id}/assignments": {
      "post": {
        "summary": "Create assignment (Assigned Instructor only)",
        "description": "Creates assignment with instructions, deadline, maxScore and allowLate setting (FR-06).",
        "tags": [
          "Assignments"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "description",
                  "deadline",
                  "maxScore"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 200
                  },
                  "description": {
                    "type": "string"
                  },
                  "deadline": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "maxScore": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 100,
                    "default": 100
                  },
                  "allowLate": {
                    "type": "boolean",
                    "default": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Assignment created and students notified"
          }
        }
      }
    },
    "/assignments": {
      "get": {
        "summary": "List assignments",
        "description": "Returns assignments across enrolled or assigned courses (FR-06, FR-07).",
        "tags": [
          "Assignments"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "courseId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Assignments retrieved"
          }
        }
      }
    },
    "/assignments/{id}": {
      "get": {
        "summary": "View assignment details",
        "description": "Returns assignment instructions, deadline, and own submission/grading status (FR-06, FR-07).",
        "tags": [
          "Assignments"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Assignment details retrieved"
          }
        }
      }
    },
    "/assignments/{id}/submissions": {
      "post": {
        "summary": "Submit assignment or replace submission (Max 5 MB)",
        "description": "Student submits text and/or file before deadline; may replace until graded/due (FR-07, SEC-07).",
        "tags": [
          "Assignments"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Submission created successfully"
          },
          "200": {
            "description": "Earlier submission replaced"
          },
          "413": {
            "description": "File size exceeds 5 MB limit"
          },
          "422": {
            "description": "Deadline expired or already graded"
          }
        }
      }
    },
    "/instructor/submissions": {
      "get": {
        "summary": "View submissions for assigned courses",
        "description": "Retrieves submissions for grading review (FR-08).",
        "tags": [
          "Grading"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "courseId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "Submitted",
                "Graded"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Submissions queue retrieved"
          }
        }
      }
    },
    "/submissions/{id}/grade": {
      "patch": {
        "summary": "Grade submission and provide feedback",
        "description": "Instructor evaluates submission with score and written feedback; recalculates progress (FR-08, FR-09).",
        "tags": [
          "Grading"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "score"
                ],
                "properties": {
                  "score": {
                    "type": "number",
                    "minimum": 0
                  },
                  "feedback": {
                    "type": "string",
                    "maxLength": 1000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Graded successfully and progress recalculated"
          }
        }
      }
    },
    "/progress": {
      "get": {
        "summary": "View learning progress and at-risk indicators",
        "description": "Returns calculated progress from submitted work (FR-09) and flags students at risk (UC-I03).",
        "tags": [
          "Progress & Achievements"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "courseId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "flagged",
            "in": "query",
            "description": "Flag at-risk students for low progress, missed deadlines, inactivity (UC-I03)",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Progress statistics retrieved"
          }
        }
      }
    },
    "/achievements": {
