    "/projects": {
      "get": {
        "summary": "List personal projects (Student only per ASM-02)",
        "description": "Returns personal projects with progress calculated from completed tasks (FR-27, FR-28).",
        "tags": [
          "Projects & Tasks"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
