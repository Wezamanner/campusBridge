        "tags": [
          "Progress & Achievements"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Leaderboard ranking retrieved"
          }
        }
      }
    },
    "/internships": {
      "get": {
        "summary": "Browse open internships",
        "description": "Browse verified active internships (FR-10, FR-11).",
        "tags": [
          "Internships"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "Remote",
                "Hybrid",
                "On-site"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Internships retrieved"
          }
        }
      }
    },
    "/internships/{id}": {
      "get": {
        "summary": "View internship details",
        "description": "Returns details, skills, and requirements for an internship (FR-10).",
        "tags": [
          "Internships"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Internship details retrieved"
          }
        }
      }
    },
    "/internships/{id}/applications": {
      "post": {
        "summary": "Apply for internship with message and CV",
        "description": "Student applies once while internship is open (FR-11).",
        "tags": [
          "Internships"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "message"
                ],
                "properties": {
                  "message": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 2000
                  },
                  "useProfileCv": {
                    "type": "boolean",
                    "default": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Application submitted successfully"
          },
          "409": {
            "description": "Already applied to this internship"
          }
        }
      }
    },
    "/applications": {
      "get": {
        "summary": "Track own internship applications",
